datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(cuid())
  name         String
  username     String      @unique
  email        String      @unique
  passwordHash String
  avatarUrl    String?
  bio          String?
  country      String?
  role         String      @default("USER") // "USER" | "ADMIN"
  status       String      @default("ACTIVE") // "ACTIVE" | "SUSPENDED"
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  purchases    Purchase[]
  freeClaims   FreeClaim[]
  downloads    Download[]
  wishlists    Wishlist[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  createdAt   DateTime  @default(now())

  projects    Project[]
}

model Project {
  id                      String      @id @default(cuid())
  title                   String
  slug                    String      @unique
  shortDescription        String
  description             String
  categoryId              String
  category                Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  techStack               String      @default("[]") // JSON string array
  version                 String      @default("1.0.0")
  liveDemoUrl             String?
  isPremium               Boolean     @default(false)
  price                   Float       @default(0.0)
  sourcePackagePath       String?     // relative storage path or filename
  thumbnail               String?
  youtubeUrl              String?
  youtubeRequiredDuration Int         @default(60) // required seconds
  published               Boolean     @default(true)
  downloadCount           Int         @default(0)
  viewCount               Int         @default(0)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  purchases               Purchase[]
  freeClaims              FreeClaim[]
  downloads               Download[]
  wishlists               Wishlist[]
}

model Purchase {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId            String
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount               Float
  currency             String    @default("USD")
  status               String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  paymentMethod        String    @default("Manual Transfer") // "Crypto", "Stripe", "PayPal", "Bank"
  transactionReference String?
  paymentProofUrl      String?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model FreeClaim {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId             String
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  youtubeWatchedSeconds Int       @default(0)
  verifiedAt            DateTime  @default(now())
  createdAt             DateTime  @default(now())

  @@unique([userId, projectId])
}

model Download {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ipAddress    String?
  userAgent    String?
  downloadedAt DateTime  @default(now())
}

model Wishlist {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, projectId])
}

model Setting {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String
  description String?
  updatedAt   DateTime  @updatedAt
}
